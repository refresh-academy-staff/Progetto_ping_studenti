{
  "external_id": "matching_picker",
  "view": {
    "type": "modal",
    "title": {
      "type": "plain_text",
      "text": "Aggiornamento"
    },
    "blocks": [
      {
        "block_id": "matching_list",
        "type": "section",
        "text": {
          "type": "mrkdwn",
          "text": "Ottimo, quale opportunità vuoi aggiornare?"
        },
        "accessory": {
          "action_id": "choose_matching",
          "type": "radio_buttons",
          "options": {{ JSON.stringify($json.options) }}
        }
      }
    ],
    "submit": {
      "type": "plain_text",
      "text": "Seleziona"
    },
    "close": {
      "type": "plain_text",
      "text": "Exit"
    },
    "private_metadata": "matching_picker_private",
    "callback_id": "view_identifier_12"
  }
}
